# ---------------------------------------------------------------------------
# agent-software-factory - environment template
# Copy to `.env` and fill in the values you need: `cp .env.example .env`
# ---------------------------------------------------------------------------

# --- LLM providers -------------------------------------------------------
# Primary provider (Anthropic). Required unless every model is overridden.
ANTHROPIC_API_KEY=
# Fallback provider (OpenAI). Used automatically on 429 / 5xx / timeouts.
OPENAI_API_KEY=
# Optional second fallback (Google). Only used if FACTORY_ENABLE_GOOGLE_FALLBACK=true.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Workspace & safety --------------------------------------------------
# Root folder that contains the target repositories. Agents can never write outside it.
FACTORY_WORKSPACE_ROOT=~/workspace
# Set to true to allow target repositories outside FACTORY_WORKSPACE_ROOT (not recommended).
FACTORY_ALLOW_ANY_PATH=false
# Allow `git push` from the pull-request step.
FACTORY_ALLOW_PUSH=true
# Allow draft pull-request creation through the GitHub CLI (`gh`).
FACTORY_ALLOW_PR=true
# Extra executables the test runner is allowed to invoke (comma separated).
FACTORY_EXTRA_ALLOWED_COMMANDS=

# --- Execution behaviour -------------------------------------------------
# Max develop -> QA -> review iterations before human escalation.
FACTORY_MAX_ATTEMPTS=3
# Per-command timeout for build/test executions (ms).
FACTORY_COMMAND_TIMEOUT_MS=900000
# Directory for run traces (relative paths resolve against the project root).
FACTORY_LOG_DIR=./logs
# Log level: debug | info | warn | error
FACTORY_LOG_LEVEL=info
# Never suspend for human input (CI mode): escalations are logged and the run ends.
FACTORY_NON_INTERACTIVE=false
# Execute the whole graph with stubbed LLM answers (no API keys, no writes).
FACTORY_DRY_RUN=false
# Use the `repomix` CLI when available (falls back to the built-in packer).
FACTORY_ENABLE_REPOMIX=true

# --- Model routing (optional overrides) ----------------------------------
# Any Mastra model-router id: `provider/model`. Chains are `primary,fallback1,fallback2`.
# Defaults are defined in src/utils/model-router.ts
# FACTORY_MODEL_PM_ARCHITECT=anthropic/claude-sonnet-4-6,openai/gpt-4o
# FACTORY_MODEL_DEVELOPER=anthropic/claude-sonnet-4-6,openai/gpt-4o
# FACTORY_MODEL_QA_TESTER=anthropic/claude-haiku-4-5,openai/gpt-4o-mini
# FACTORY_MODEL_TRIAGE=anthropic/claude-sonnet-4-6,openai/gpt-4o
# FACTORY_MODEL_REVIEWER=anthropic/claude-sonnet-4-6,openai/gpt-4o-mini
# FACTORY_MODEL_SECURITY=anthropic/claude-sonnet-4-6,openai/gpt-4o
# FACTORY_MODEL_DOCUMENTATION=anthropic/claude-haiku-4-5,openai/gpt-4o-mini

# --- Observability -------------------------------------------------------
# Local persistence for workflow snapshots (suspend/resume) and traces.
FACTORY_STORAGE_URL=file:./logs/factory.db
# Export OpenTelemetry traces to an OTLP endpoint (optional).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=agent-software-factory
