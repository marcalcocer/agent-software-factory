{
  "name": "ai-factory-studio",
  "version": "0.1.0",
  "description": "Desktop UI for the multi-agent software factory",
  "author": "AI Factory Studio",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "bundle": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "open": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "32.3.3",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.1"
  }
}
