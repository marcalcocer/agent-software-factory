diff --git a/ui/src/lib/__tests__/theme.test.js b/ui/src/lib/__tests__/theme.test.js
new file mode 100644
index 0000000..309147f
--- /dev/null
+++ b/ui/src/lib/__tests__/theme.test.js
@@ -0,0 +1,206 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    THEME_STORAGE_KEY,
+    THEMES,
+    normalizeTheme,
+    nextTheme,
+    resolveIsDark,
+    getStoredTheme,
+    storeTheme,
+    applyTheme,
+    cycleStoredTheme,
+    applyStoredSystemTheme,
+} from '../theme.js';
+
+describe('normalizeTheme', () => {
+    it('should return system when value is null', () => {
+        assert.equal(normalizeTheme(null), 'system');
+    });
+
+    it('should return system when value is invalid', () => {
+        assert.equal(normalizeTheme('purple'), 'system');
+    });
+
+    it('should keep valid values', () => {
+        THEMES.forEach((theme) => assert.equal(normalizeTheme(theme), theme));
+    });
+});
+
+describe('nextTheme', () => {
+    it('should cycle light -> dark -> system -> light', () => {
+        assert.equal(nextTheme('light'), 'dark');
+        assert.equal(nextTheme('dark'), 'system');
+        assert.equal(nextTheme('system'), 'light');
+    });
+
+    it('should return light when current is unknown', () => {
+        assert.equal(nextTheme('nope'), 'light');
+    });
+});
+
+describe('resolveIsDark', () => {
+    it('should return true for dark regardless of OS', () => {
+        assert.equal(resolveIsDark('dark', false), true);
+        assert.equal(resolveIsDark('dark', true), true);
+    });
+
+    it('should return false for light regardless of OS', () => {
+        assert.equal(resolveIsDark('light', true), false);
+        assert.equal(resolveIsDark('light', false), false);
+    });
+
+    it('should follow the OS for system', () => {
+        assert.equal(resolveIsDark('system', true), true);
+        assert.equal(resolveIsDark('system', false), false);
+    });
+});
+
+describe('getStoredTheme and storeTheme', () => {
+    it('should round-trip a stored theme', () => {
+        var storage = createFakeStorage();
+
+        var stored = storeTheme('dark', storage);
+
+        assert.equal(stored, true);
+        assert.equal(storage.data.get(THEME_STORAGE_KEY), 'dark');
+        assert.equal(getStoredTheme(storage), 'dark');
+    });
+
+    it('should return system when nothing is stored', () => {
+        assert.equal(getStoredTheme(createFakeStorage()), 'system');
+    });
+
+    it('should tolerate a storage that throws', () => {
+        var storage = {
+            getItem() {
+                throw new Error('blocked');
+            },
+            setItem() {
+                throw new Error('blocked');
+            },
+        };
+
+        assert.equal(getStoredTheme(storage), 'system');
+        assert.equal(storeTheme('dark', storage), false);
+    });
+});
+
+describe('applyTheme', () => {
+    it('should add the dark class and color scheme when theme is dark', () => {
+        var root = createFakeRoot();
+
+        var result = applyTheme('dark',{ root, matchMedia: createMatchMedia(false) });
+
+        assert.equal(result, true);
+        assert.equal(root.classes.has('dark'), true);
+        assert.equal(root.style.colorScheme, 'dark');
+    });
+
+    it('should remove the dark class when theme is light and OS is dark', () => {
+        var root = createFakeRoot();
+        root.classes.add('dark');
+
+        var result = applyTheme('light',{ root, matchMedia: createMatchMedia(true) });
+
+        assert.equal(result, false);
+        assert.equal(root.classes.has('dark'), false);
+        assert.equal(root.style.colorScheme, 'light');
+    });
+
+    it('should follow the OS when theme is system', () => {
+        var darkRoot = createFakeRoot();
+        var lightRoot = createFakeRoot();
+
+        applyTheme('system', { root: darkRoot, matchMedia: createMatchMedia(true) });
+        applyTheme('system', { root: lightRoot, matchMedia: createMatchMedia(false) });
+
+        assert.equal(darkRoot.classes.has('dark'), true);
+        assert.equal(lightRoot.classes.has('dark'), false);
+    });
+});
+
+describe('cycleStoredTheme', () => {
+    it('should persist and apply the next theme', () => {
+        var storage = createFakeStorage();
+        var root = createFakeRoot();
+
+        var result = cycleStoredTheme('light', { storage, root, matchMedia: createMatchMedia(false) });
+
+        assert.equal(result, 'dark');
+        assert.equal(storage.data.get(THEME_STORAGE_KEY), 'dark');
+        assert.equal(root.classes.has('dark'), true);
+    });
+
+    it('should wrap from system back to light and remove the dark class', () => {
+        var storage = createFakeStorage();
+        var root = createFakeRoot();
+        root.classes.add('dark');
+
+        var result = cycleStoredTheme('system', { storage, root, matchMedia: createMatchMedia(true) });
+
+        assert.equal(result, 'light');
+        assert.equal(storage.data.get(THEME_STORAGE_KEY), 'light');
+        assert.equal(root.classes.has('dark'), false);
+    });
+});
+
+describe('applyStoredSystemTheme', () => {
+    it('should apply the OS theme when the stored preference is system', () => {
+        var storage = createFakeStorage();
+        var root = createFakeRoot();
+
+        var result = applyStoredSystemTheme({ storage, root, matchMedia: createMatchMedia(true) });
+
+        assert.equal(result, 'system');
+        assert.equal(root.classes.has('dark'), true);
+    });
+
+    it('should not override an explicit light choice', () => {
+        var storage = createFakeStorage();
+        storage.setItem(THEME_STORAGE_KEY, 'light');
+        var root = createFakeRoot();
+
+        var result = applyStoredSystemTheme({ storage, root, matchMedia: createMatchMedia(true) });
+
+        assert.equal(result, 'light');
+        assert.equal(root.classes.has('dark'), false);
+    });
+
+    it('should not override an explicit dark choice', () => {
+        var storage = createFakeStorage();
+        storage.setItem(THEME_STORAGE_KEY, 'dark');
+        var root = createFakeRoot();
+        root.classes.add('dark');
+
+        var result = applyStoredSystemTheme({ storage, root, matchMedia: createMatchMedia(false) });
+
+        assert.equal(result, 'dark');
+        assert.equal(root.classes.has('dark'), true);
+    });
+});
+
+function createFakeStorage() {
+    var data = new Map();
+    return {
+        data,
+        getItem: (key) => (data.has(key) ? data.get(key) : null),
+        setItem: (key, value) => data.set(key, value),
+    };
+}
+
+function createFakeRoot() {
+    var classes = new Set();
+    return {
+        classes,
+        style: {},
+        classList: {
+            add: (name) => classes.add(name),
+            remove: (name) => classes.delete(name),
+        },
+    };
+}
+
+function createMatchMedia(matches) {
+    return () => ({ matches });
+}
diff --git a/ui/src/lib/theme.js b/ui/src/lib/theme.js
new file mode 100644
index 0000000..4838557
--- /dev/null
+++ b/ui/src/lib/theme.js
@@ -0,0 +1,77 @@
+export const THEME_STORAGE_KEY = 'theme';
+export const THEME_CHANGE_EVENT = 'themeChanged';
+export const THEMES = ['light', 'dark', 'system'];
+export const DARK_MEDIA_QUERY = '(prefers-color-scheme: dark)';
+
+export const normalizeTheme = (value) => (THEMES.includes(value) ? value : 'system');
+
+export const nextTheme = (current) => {
+    var index = THEMES.indexOf(current);
+    if (index === -1) {
+        return THEMES[0];
+    }
+    return THEMES[(index + 1) % THEMES.length];
+};
+
+export const resolveIsDark = (theme, prefersDark) => {
+    if (theme === 'dark') {
+        return true;
+    }
+    if (theme === 'light') {
+        return false;
+    }
+    return Boolean(prefersDark);
+};
+
+export const getStoredTheme = (storage) => {
+    try {
+        return normalizeTheme(storage.getItem(THEME_STORAGE_KEY));
+    } catch {
+        return 'system';
+    }
+};
+
+export const storeTheme = (theme, storage) => {
+    try {
+        storage.setItem(THEME_STORAGE_KEY, normalizeTheme(theme));
+        return true;
+    } catch {
+        return false;
+    }
+};
+
+export const applyTheme = (theme, { root, matchMedia }) => {
+    var prefersDark = typeof matchMedia === 'function' ? matchMedia(DARK_MEDIA_QUERY).matches : false;
+    var isDark = resolveIsDark(normalizeTheme(theme), prefersDark);
+    if (isDark) {
+        root.classList.add('dark');
+    } else {
+        root.classList.remove('dark');
+    }
+    root.style.colorScheme = isDark ? 'dark' : 'light';
+    return isDark;
+};
+
+/**
+ * Moves to the next theme in the cycle, persists it and applies it.
+ * Returns the new theme.
+ */
+export const cycleStoredTheme = (current, { storage, root, matchMedia }) => {
+    var newTheme = nextTheme(current);
+    storeTheme(newTheme, storage);
+    applyTheme(newTheme, { root, matchMedia });
+    return newTheme;
+};
+
+/**
+ * Re-resolves the theme from storage and applies it only when the stored
+ * preference is 'system'. Safe to call from stale listeners: an explicit
+ * light/dark choice is never overridden. Returns the stored theme.
+ */
+export const applyStoredSystemTheme = ({ storage, root, matchMedia }) => {
+    var stored = getStoredTheme(storage);
+    if (stored === 'system') {
+        applyTheme('system', { root, matchMedia });
+    }
+    return stored;
+};
