new file mode 100644
index 0000000..9c55ad1
--- /dev/null
+++ b/ui/src/components/ThemeToggle.jsx
@@ -0,0 +1,80 @@
+import { useState, useEffect } from 'react';
+import { SunIcon, MoonIcon, ComputerDesktopIcon } from '@heroicons/react/24/outline';
+import {
+    THEME_CHANGE_EVENT,
+    THEME_STORAGE_KEY,
+    DARK_MEDIA_QUERY,
+    getStoredTheme,
+    normalizeTheme,
+    applyStoredSystemTheme,
+    cycleStoredTheme,
+} from '../lib/theme.js';
+
+const LABELS = {
+    light: 'Light',
+    dark: 'Dark',
+    system: 'System default',
+};
+
+export default function ThemeToggle() {
+    const [theme, setTheme] = useState('system');
+
+    useEffect(() => {
+        setTheme(getStoredTheme(window.localStorage));
+
+        const handleThemeChange = (event) => {
+            setTheme(normalizeTheme(event.detail));
+        };
+        const handleStorage = (event) => {
+            if (event.key === THEME_STORAGE_KEY) {
+                setTheme(getStoredTheme(window.localStorage));
+            }
+        };
+        window.addEventListener(THEME_CHANGE_EVENT, handleThemeChange);
+        window.addEventListener('storage', handleStorage);
+        return () => {
+            window.removeEventListener(THEME_CHANGE_EVENT, handleThemeChange);
+            window.removeEventListener('storage', handleStorage);
+        };
+    }, []);
+
+    useEffect(() => {
+        if (theme !== 'system') {
+            return undefined;
+        }
+        var mediaQuery = window.matchMedia(DARK_MEDIA_QUERY);
+        const handleChange = () => {
+            applyStoredSystemTheme({
+                storage: window.localStorage,
+                root: document.documentElement,
+                matchMedia: window.matchMedia.bind(window),
+            });
+        };
+        mediaQuery.addEventListener('change', handleChange);
+        return () => mediaQuery.removeEventListener('change', handleChange);
+    }, [theme]);
+
+    const cycleTheme = () => {
+        var newTheme = cycleStoredTheme(theme, {
+            storage: window.localStorage,
+            root: document.documentElement,
+            matchMedia: window.matchMedia.bind(window),
+        });
+        setTheme(newTheme);
+        window.dispatchEvent(new CustomEvent(THEME_CHANGE_EVENT, { detail: newTheme }));
+    };
+
+    const label = `Theme: ${LABELS[theme]}`;
+    const Icon = theme === 'light' ? SunIcon : theme === 'dark' ? MoonIcon : ComputerDesktopIcon;
+
+    return (
+        <button
+            onClick={cycleTheme}
+            className="p-2 text-gray-500 hover:text-gray-700 dark:text-gray-300 dark:hover:text-white focus:outline-none transition-colors duration-200"
+            title={label}
+            aria-label={label}
+        >
+            <Icon className="w-6 h-6" />
+        </button>
+    );
+}
