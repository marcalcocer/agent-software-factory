+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import {
+    THEME_CHANGE_EVENT,
+    THEME_STORAGE_KEY,
+    applyTheme,
+    getStoredTheme,
+    resolveTheme,
+    setTheme,
+    subscribeToSystemTheme,
+}from "../theme.js";
+
+describe("theme.resolveTheme", () => {
+    it("returns light when the preference is light regardless of the system", () => {
+        assert.equal(resolveTheme("light", true), "light");
+        assert.equal(resolveTheme("light", false), "light");
+    });
+
+    it("returns dark when the preference is dark regardless of the system", () => {
+        assert.equal(resolveTheme("dark", true), "dark");
+        assert.equal(resolveTheme("dark", false), "dark");
+    });
+
+    it("follows the system when the preference is system", () => {
+        assert.equal(resolveTheme("system", true), "dark");
+        assert.equal(resolveTheme("system", false), "light");
+    });
+});
+
+describe("theme.getStoredTheme", () => {
+    it("falls back to system when nothing is stored", () => {
+        assert.equal(getStoredTheme(createStorage()), "system");
+    });
+
+    it("falls back to system when the stored value is invalid", () => {
+        assert.equal(getStoredTheme(createStorage("purple")), "system");
+    });
+
+    it("returns the stored value when it is valid", () => {
+        assert.equal(getStoredTheme(createStorage("dark")), "dark");
+        assert.equal(getStoredTheme(createStorage("light")), "light");
+    });
+
+    it("falls back to system when storage throws", () => {
+        const storage = {
+            getItem() {
+                throw new Error("denied");
+            },
+        };
+        assert.equal(getStoredTheme(storage), "system");
+    });
+});
+
+describe("theme.applyTheme", () => {
+    it("adds the dark class when the preference is dark", () => {
+        const doc = createDocument();
+
+        const resolved = applyTheme("dark", doc, createMatchMedia(false));
+
+        assert.equal(resolved, "dark");
+        assert.ok(doc.documentElement.classes.has("dark"));
+    });
+
+    it("removes the dark class when the preference is light", () => {
+        const doc = createDocument(["dark"]);
+
+        const resolved = applyTheme("light", doc, createMatchMedia(true));
+
+        assert.equal(resolved, "light");
+        assert.ok(!doc.documentElement.classes.has("dark"));
+    });
+
+    it("applies the dark class when system is selected and the OS prefers dark", () => {
+        const doc = createDocument();
+
+        applyTheme("system", doc, createMatchMedia(true));
+
+        assert.ok(doc.documentElement.classes.has("dark"));
+    });
+
+    it("removes the dark class when system is selected and the OS prefers light", () => {
+        const doc = createDocument(["dark"]);
+
+        applyTheme("system", doc, createMatchMedia(false));
+
+        assert.ok(!doc.documentElement.classes.has("dark"));
+    });
+});
+
+describe("theme.setTheme", () => {
+    it("persists the preference and applies it", () => {
+        const storage = createStorage();
+        const doc = createDocument();
+
+        const resolved = setTheme("dark", storage, doc, createMatchMedia(false));
+
+        assert.equal(resolved, "dark");
+        assert.equal(storage.getItem(THEME_STORAGE_KEY), "dark");
+        assert.ok(doc.documentElement.classes.has("dark"));
+    });
+
+    it("stores system when the preference is invalid", () => {
+        const storage = createStorage();
+        const doc = createDocument();
+
+        setTheme("bogus", storage, doc, createMatchMedia(false));
+
+        assert.equal(storage.getItem(THEME_STORAGE_KEY), "system");
+    });
+
+    it("dispatches the theme change event with the stored value", () => {
+        const dispatched = [];
+        const originalWindow = globalThis.window;
+        const originalCustomEvent = globalThis.CustomEvent;
+        globalThis.window = { dispatchEvent: (event) => dispatched.push(event) };
+        globalThis.CustomEvent = class {
+            constructor(type, init) {
+                this.type = type;
+                this.detail = init.detail;
+            }
+        };
+        const storage = createStorage();
+
+        try {
+            setTheme("dark", storage, createDocument(), createMatchMedia(false));
+        } finally {
+            globalThis.window = originalWindow;
+            globalThis.CustomEvent = originalCustomEvent;
+        }
+
+        assert.equal(dispatched.length, 1);
+        assert.equal(dispatched[0].type, THEME_CHANGE_EVENT);
+        assert.equal(dispatched[0].detail, storage.getItem(THEME_STORAGE_KEY));
+    });
+});
+
+describe("theme.subscribeToSystemTheme", () => {
+    it("applies the dark class on an OS change while the preference is system", () => {
+        const doc = createDocument();
+        const media = createChangeableMatchMedia(false);
+        subscribeToSystemTheme(media.matchMedia, doc, () => "system");
+
+        media.change(true);
+
+        assert.ok(doc.documentElement.classes.has("dark"));
+    });
+
+    it("ignores OS changes while the preference is light", () => {
+        const doc = createDocument();
+        const media = createChangeableMatchMedia(false);
+        subscribeToSystemTheme(media.matchMedia, doc, () => "light");
+
+        media.change(true);
+
+        assert.ok(!doc.documentElement.classes.has("dark"));
+    });
+
+    it("ignores OS changes while the preference is dark", () => {
+        const doc = createDocument(["dark"]);
+        const media = createChangeableMatchMedia(false);
+        subscribeToSystemTheme(media.matchMedia, doc, () => "dark");
+
+        media.change(false);
+
+        assert.ok(doc.documentElement.classes.has("dark"));
+    });
+
+    it("stops reacting after unsubscribe", () => {
+        const doc = createDocument();
+        const media = createChangeableMatchMedia(false);
+        const unsubscribe = subscribeToSystemTheme(media.matchMedia, doc, () => "system");
+
+        unsubscribe();
+        media.change(true);
+
+        assert.ok(!doc.documentElement.classes.has("dark"));
+    });
+});
+
+function createChangeableMatchMedia(initialMatches) {
+    let matches = initialMatches;
+    const listeners = new Set();
+    const mediaQueryList = {
+        get matches() {
+            return matches;
+        },
+        addEventListener: (_type, listener) => listeners.add(listener),
+        removeEventListener: (_type, listener) => listeners.delete(listener),
+    };
+    return {
+        matchMedia: () => mediaQueryList,
+        change: (value) => {
+            matches = value;
+            listeners.forEach((listener) => listener());
+        },
+    };
+}
+
+function createStorage(initialValue = null) {
+    let value = initialValue;
+    return {
+        getItem: () => value,
+        setItem: (_key, newValue) => {
+            value = newValue;
+        },
+    };
+}
+
+function createDocument(initialClasses = []) {
+    const classes = new Set(initialClasses);
+    return {
+        documentElement: {
+            classes,
+            style: {},
+            classList: {
+                add: (name) => classes.add(name),
+                remove: (name) => classes.delete(name),
+            },
+        },
+    };
+}
+
+function createMatchMedia(prefersDark) {
+    return () => ({ matches: prefersDark });
+}
