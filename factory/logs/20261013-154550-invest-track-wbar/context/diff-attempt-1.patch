new file mode 100644
index 0000000..e888003
--- /dev/null
+++ b/ui/src/lib/theme.js
@@ -0,0 +1,50 @@
+export const THEME_STORAGE_KEY = 'theme';
+export const THEME_CHANGE_EVENT = 'themeChanged';
+export const THEME_PREFERENCES = ['light', 'dark', 'system'];
+
+const DARK_QUERY = '(prefers-color-scheme: dark)';
+
+export const getStoredTheme = (storage) => {
+    try {
+        const value = storage ? storage.getItem(THEME_STORAGE_KEY) : null;
+        return THEME_PREFERENCES.includes(value) ? value : 'system';
+    } catch {
+        return 'system';
+    }
+};
+
+export const resolveTheme = (preference, systemPrefersDark) => {
+    if (preference === 'light' || preference === 'dark') {
+        return preference;
+    }
+    return systemPrefersDark ? 'dark' : 'light';
+};
+
+export const applyTheme = (preference, doc, matchMedia) => {
+    const systemPrefersDark = typeof matchMedia === 'function' ? Boolean(matchMedia(DARK_QUERY).matches) : false;
+    const resolved = resolveTheme(preference, systemPrefersDark);
+    const root = doc.documentElement;
+    if (resolved === 'dark') {
+        root.classList.add('dark');
+    } else {
+        root.classList.remove('dark');
+    }
+    if (root.style) {
+        root.style.colorScheme = resolved;
+    }
+    return resolved;
+};
+
+export const setTheme = (preference, storage = window.localStorage, doc = document, matchMedia = window.matchMedia.bind(window)) => {
+    const value = THEME_PREFERENCES.includes(preference) ? preference : 'system';
+    try {
+        storage.setItem(THEME_STORAGE_KEY, value);
+    } catch {
+        // Storage may be unavailable (private mode); the theme is still applied for this session.
+    }
+    const resolved = applyTheme(value, doc, matchMedia);
+    if (typeof window !== 'undefined') {
+        window.dispatchEvent(new CustomEvent(THEME_CHANGE_EVENT, { detail: value }));
+    }
+    return resolved;
+};
