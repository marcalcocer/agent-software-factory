{
  "name": "agent-software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asynchronous multi-agent software factory built on the Mastra framework. Plans, implements, tests, reviews, secures, documents and ships changes on any repository inside ~/workspace.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "factory": "tsx src/cli/factory.ts",
    "factory:run": "tsx src/cli/factory.ts run",
    "factory:resume": "tsx src/cli/factory.ts resume",
    "smoke": "tsx src/cli/smoke.ts",
    "test": "vitest run",
    "dev": "mastra dev",
    "build": "mastra build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run smoke"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mastra/core": "^1.75.0",
    "@mastra/libsql": "^1.25.1",
    "@mastra/loggers": "^1.3.5",
    "@mastra/observability": "^1.18.4",
    "@mastra/otel-exporter": "^1.4.5",
    "dotenv": "^17.2.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "mastra": "^1.33.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
