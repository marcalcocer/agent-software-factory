# ---------------------------------------------------------------------------
# agent-software-factory - environment template
# Copy to `.env` and fill in the values you need: `cp .env.example .env`
# ---------------------------------------------------------------------------

# --- Execution backend ---------------------------------------------------
# api        = metered provider SDKs (needs an API key below).
# claude-cli = the official `claude` binary in headless mode, backed by a
#              Claude Pro/Max subscription instead of per-token billing.
#              Requires Claude Code installed and `claude login` done once.
FACTORY_PROVIDER=api

# --- claude-cli backend (only used when FACTORY_PROVIDER=claude-cli) -----
# Optional caching/compression proxy in front of the Anthropic API, e.g. Headroom.
# ANTHROPIC_BASE_URL is honoured too, so an existing proxy setup needs no extra config.
FACTORY_CLAUDE_CLI_BASE_URL=
# Timeout for a single headless call (implementation steps can be slow).
FACTORY_CLAUDE_CLI_TIMEOUT_MS=600000
# Hard per-call spend ceiling (`--max-budget-usd`). Empty = no ceiling.
FACTORY_CLAUDE_CLI_MAX_BUDGET_USD=
# Grant Claude Code's own file tools, scoped to the target repo. Disabling this makes every
# agent context-only, which the inspection roles cannot work with: keep it enabled.
FACTORY_CLAUDE_CLI_FILE_TOOLS=true
# Per-role model override: "primary,fallback1,...". Aliases (haiku/sonnet/opus) or full ids.
# Defaults: sonnet for reasoning roles, haiku for qa-tester and documentation.
FACTORY_CLI_MODEL_PM_ARCHITECT=
FACTORY_CLI_MODEL_DEVELOPER=
FACTORY_CLI_MODEL_QA_TESTER=
FACTORY_CLI_MODEL_TRIAGE=
FACTORY_CLI_MODEL_SECURITY=
FACTORY_CLI_MODEL_REVIEWER=
FACTORY_CLI_MODEL_DOCUMENTATION=
# Model a cheap-tier call escalates to when its output fails schema validation twice.
FACTORY_CLI_ESCALATION_MODEL=sonnet

# --- LLM providers (only used when FACTORY_PROVIDER=api) -----------------
# The only credential the default chains need. Failover is cross-tier within Anthropic
# (sonnet <-> haiku), so no second vendor is required.
ANTHROPIC_API_KEY=
# Optional last-resort fallback appended to every chain if
# FACTORY_ENABLE_GOOGLE_FALLBACK=true. Not needed otherwise.
GOOGLE_GENERATIVE_AI_API_KEY=
# Other providers are supported but never configured by default. Point any role at one with
# FACTORY_MODEL_<ROLE>, e.g.
#   FACTORY_MODEL_DEVELOPER="anthropic/claude-opus-4-5,anthropic/claude-sonnet-4-6"
# Supply that provider's own key (OPENAI_API_KEY, GROQ_API_KEY, ...) if you do.

# --- Free tier (optional; only with FACTORY_PROVIDER=claude-cli) ---------
# Try free-quota models before Claude for the small roles that need no tools. If none answers (out of
# quota, key refused, wrong shape), Claude does, and the Studio shows which model answered each step and why.
# Eligible roles: run-namer, merge-summary, pr-writer, phase-reconciler. Needs the provider keys above.
# FACTORY_FREE_ROLES=run-namer,merge-summary,pr-writer
# FACTORY_FREE_CHAIN=google/gemini-3.1-flash-lite,google/gemini-3.5-flash-lite
# Minutes to leave a model alone after it says it is out of quota (a daily quota waits 6 hours).
# FACTORY_FREE_COOLDOWN_MINUTES=15

# --- Workspace & safety --------------------------------------------------
# Root folder that contains the target repositories (`--repo invest-track` is looked up there).
# Agents can never write outside the workspace, the checkouts folder and the repositories listed below.
FACTORY_WORKSPACE_ROOT=~/workspace
# Repositories OUTSIDE the workspace that you want to work on: absolute paths, separated like PATH (":").
# The Studio sets this for every repository you add, so you only need it when you use the CLI.
# FACTORY_EXTRA_REPOS=/home/me/projects/invest-track:/home/me/projects/other
# Where each task's checkout is made. Keep it somewhere that survives a restart (not /tmp), and not inside a
# project that has node_modules (the checkout would find that project's packages). Default shown.
# FACTORY_WORKTREES_DIR=~/workspace/.factory/worktrees
# Set to true to lift the boundary altogether (not recommended: list the repositories above instead).
FACTORY_ALLOW_ANY_PATH=false
# Allow `git push` from the pull-request step.
FACTORY_ALLOW_PUSH=true

# Where a task works: "worktree" (a checkout of its own, in FACTORY_WORKTREES_DIR - your repository is
# never touched) or "in-place" (your repository itself; it must be clean).
# FACTORY_ISOLATION=worktree
# Files copied into each checkout (comma separated, relative to the repository). Only files git ignores.
# FACTORY_WORKTREE_COPY=.env
# Allow draft pull-request creation through the GitHub CLI (`gh`).
FACTORY_ALLOW_PR=true
# Extra executables the test runner is allowed to invoke (comma separated).
FACTORY_EXTRA_ALLOWED_COMMANDS=

# --- Execution behaviour -------------------------------------------------
# Max develop -> QA -> review iterations before human escalation.
FACTORY_MAX_ATTEMPTS=3
# Per-command timeout for build/test executions (ms).
FACTORY_COMMAND_TIMEOUT_MS=900000
# Directory for run traces (relative paths resolve against the project root).
FACTORY_LOG_DIR=./logs
# Log level: debug | info | warn | error
FACTORY_LOG_LEVEL=info
# Never suspend for human input (CI mode): escalations are logged and the run ends.
FACTORY_NON_INTERACTIVE=false
# Execute the whole graph with stubbed LLM answers (no API keys, no writes).
FACTORY_DRY_RUN=false
# Use the `repomix` CLI when available (falls back to the built-in packer).
FACTORY_ENABLE_REPOMIX=true

# --- Model routing (optional overrides) ----------------------------------
# Any Mastra model-router id: `provider/model`. Chains are `primary,fallback1,fallback2`.
# Defaults are defined in src/utils/model-router.ts
# FACTORY_MODEL_PM_ARCHITECT=anthropic/claude-sonnet-4-6,openai/gpt-4o
# FACTORY_MODEL_DEVELOPER=anthropic/claude-sonnet-4-6,openai/gpt-4o
# FACTORY_MODEL_QA_TESTER=anthropic/claude-haiku-4-5,openai/gpt-4o-mini
# FACTORY_MODEL_TRIAGE=anthropic/claude-sonnet-4-6,openai/gpt-4o
# FACTORY_MODEL_REVIEWER=anthropic/claude-sonnet-4-6,openai/gpt-4o-mini
# FACTORY_MODEL_SECURITY=anthropic/claude-sonnet-4-6,openai/gpt-4o
# FACTORY_MODEL_DOCUMENTATION=anthropic/claude-haiku-4-5,openai/gpt-4o-mini

# --- Observability -------------------------------------------------------
# Local persistence for workflow snapshots (suspend/resume) and traces.
FACTORY_STORAGE_URL=file:./logs/factory.db
# Export OpenTelemetry traces to an OTLP endpoint (optional).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=agent-software-factory
